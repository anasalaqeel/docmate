# Grud Backend Configuration
# Copy this file to .env and fill in the values.

# Server Configuration
PORT=8000
APP_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# Database
# For local development: postgres://user:password@localhost:5432/grud
DATABASE_URL=postgres://postgres:password@localhost:5432/grud

# Authentication
# Secret key for JWT signing. Generate a secure random string.
AUTH_JWT_SECRET=your_jwt_secret_here
# Cookie settings (optional, defaults to secure=false, sameSite=Lax in dev)
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=Lax

# Initial Admin User Seeding
# These values are used by 'bun run drizzle:seed' to create the first admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=your_secure_password
