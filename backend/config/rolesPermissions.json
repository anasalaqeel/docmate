[
  {
    "name": "superadmin",
    "description": "Complete system access",
    "permissions": [{ "name": "system:all", "description": "Full system access" }]
  },
  {
    "name": "admin",
    "description": "Administrative access",
    "permissions": [
      { "name": "users:create", "description": "Create users" },
      { "name": "users:read", "description": "View users" },
      { "name": "users:update", "description": "Update users" },
      { "name": "users:delete", "description": "Delete users" },
      { "name": "roles:manage", "description": "Manage roles and permissions" },
      { "name": "content:manage", "description": "Manage all content" },
      { "name": "settings:manage", "description": "Manage system settings" },
      { "name": "docs:create", "description": "Create documentations" },
      { "name": "docs:read", "description": "View all documentations" },
      { "name": "docs:update", "description": "Update any documentation" },
      { "name": "docs:delete", "description": "Delete any documentation" },
      { "name": "docs:manage", "description": "Full documentation management" },
      { "name": "docs:export", "description": "Export any documentation" }
    ]
  },
  {
    "name": "moderator",
    "description": "Content management",
    "permissions": [
      { "name": "content:read", "description": "View content" },
      { "name": "content:create", "description": "Create content" },
      { "name": "content:update", "description": "Update content" },
      { "name": "users:read", "description": "View users" },
      { "name": "docs:create", "description": "Create documentations" },
      { "name": "docs:read", "description": "View all documentations" },
      { "name": "docs:update", "description": "Update own documentations" },
      { "name": "docs:export", "description": "Export any documentation" }
    ]
  },
  {
    "name": "user",
    "description": "Standard user access",
    "permissions": [
      { "name": "profile:manage", "description": "Manage own profile" },
      { "name": "content:read", "description": "View content" },
      { "name": "docs:export:own", "description": "Export own documentations" }
    ]
  }
]
