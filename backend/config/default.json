{
  "port": 8000,
  "cookie": {
    "secure": false,
    "sameSite": "Lax",
    "path": "/v1"
  },
  "uploads": {
    "maxSize": 26214400,
    "configs": {
      "logo": {
        "maxSize": 2097152
      },
      "favicon": {
        "maxSize": 524288
      },
      "custom_asset": {
        "maxSize": 5242880
      },
      "attachment": {
        "maxSize": 26214400
      }
    }
  },
  "ldap": {
    "enabled": false,
    "url": "ldap://localhost:389",
    "bindDn": "",
    "bindPassword": "",
    "searchBase": "",
    "searchFilter": "(uid={{username}})",
    "tls": {
      "enabled": false,
      "rejectUnauthorized": true
    },
    "attributes": {
      "username": "uid",
      "email": "mail",
      "firstName": "givenName",
      "lastName": "sn",
      "displayName": "cn"
    },
    "group": {
      "searchBase": "",
      "searchFilter": "(member={{dn}})",
      "attribute": "cn",
      "roleMap": {}
    },
    "defaultRole": "user"
  }
}
