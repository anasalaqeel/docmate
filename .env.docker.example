# Grud Docker Environment Variables
# This file is specifically for running the project using Docker Compose.
# Copy this file to .env.docker and fill in the values.

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=grud
DATABASE_URL=postgres://postgres:password@database:5432/grud

# Backend Configuration
PORT=8000
AUTH_JWT_SECRET=generate_a_secure_random_string_here
CORS_ORIGINS=http://localhost:5173,http://localhost

# Initial Admin Seeding (Required for first startup)
SEED_ADMIN_USER=admin@grud.local
SEED_ADMIN_PASSWORD=SetAStrongPassword123!

# Frontend Configuration (Build-time)
VITE_API_BASE_URL=http://localhost:8000/v1
