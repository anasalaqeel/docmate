# Grud Docker Environment Variables
# Copy this file to .env and fill in the values.

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=grud

# Backend Configuration
# PORT: internal port the app listens on inside the container (don't change)
PORT=8000
AUTH_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

# Initial Admin Seeding (Required for first startup)
SEED_DATABASE=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Frontend Configuration
# FRONTEND_PORT: port exposed on the host machine (maps to container's port 80)
FRONTEND_PORT=3000
