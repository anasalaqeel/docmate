# Docmate Docker Environment Variables
# Copy this file to .env and fill in the values.

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=docmate

# Backend Configuration
# PORT: internal port the app listens on inside the container (don't change)
PORT=8000
AUTH_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
# APP_URL: public URL of this deployment (e.g. https://docs.example.com).
# Used to build SAML SP metadata/ACS URLs. If unset, the request origin is used.
# APP_URL=https://docs.example.com
# COOKIE_SECURE: set to true when serving over HTTPS
# COOKIE_SECURE=true
# LDAP_BIND_CREDENTIALS: when set, overrides the LDAP bind password from the
# admin settings UI (keeps the secret out of the database)
# LDAP_BIND_CREDENTIALS=
# AI_API_KEY: when set, overrides the AI provider API key from the admin
# settings UI (keeps the secret out of the database)
# AI_API_KEY=

# Initial Admin Seeding (Required for first startup)
SEED_DATABASE=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Frontend Configuration
# FRONTEND_PORT: port exposed on the host machine (maps to container's port 80)
FRONTEND_PORT=3000
ENABLE_SSL=false
